datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Event {
  id       String   @id @default(cuid())
  name     String
  venue    String
  city     String
  category String
  date     DateTime
  price    Float
  stock    Int
  tickets  Ticket[]
}

model Ticket {
  id        String   @id @default(cuid())
  holder    String
  deviceId  String
  seed      String
  used      Boolean  @default(false)
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  createdAt DateTime @default(now())
}
